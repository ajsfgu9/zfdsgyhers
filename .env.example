# Primary OpenAI-compatible or local vLLM / OpenRouter / Nous Portal / xAI Grok endpoint
OUROBOROS_API_BASE=https://api.openai.com/v1
OUROBOROS_API_KEY=sk-replace-with-your-key
OUROBOROS_MODEL=gpt-4.1

# Optional role-specific model overrides for the 5-Role Quant Desk
OUROBOROS_SWEEPER_MODEL=gpt-4.1-mini
OUROBOROS_SKEPTIC_MODEL=gpt-4.1

# Telegram Bot Integration (auto-reloaded live without restarting the daemon!)
# Supports TELEGRAM_BOT_TOKEN (or BOT_TOKEN) and TELEGRAM_CHAT_ID (or CHAT_ID)
TELEGRAM_BOT_TOKEN=123456789:replace-with-your-telegram-bot-token
TELEGRAM_CHAT_ID=replace-with-your-telegram-chat-id

# Server workspace, skills, and hot-pluggable tools directories
OUROBOROS_WORKSPACE=/var/lib/ouroboros/workspace_state
OUROBOROS_SKILLS_DIR=/opt/ouroboros-agent/skills
OUROBOROS_PLUGINS_DIR=/opt/ouroboros-agent/plugins
